{
  "name": "shivax",
  "version": "0.1.1",
  "description": "JavaScript and TypeScript multi-agent AI framework with neural networks, controlled workflows, model adapters, scoped memory, UI inspection and evaluation.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/sdk/core.d.ts",
      "import": "./dist/sdk/core.esm.js",
      "require": "./dist/sdk/core.cjs"
    },
    "./rudra": {
      "types": "./dist/sdk/rudra.d.ts",
      "import": "./dist/sdk/rudra.esm.js",
      "require": "./dist/sdk/rudra.cjs"
    },
    "./bots": {
      "types": "./dist/sdk/bots.d.ts",
      "import": "./dist/sdk/bots.esm.js",
      "require": "./dist/sdk/bots.cjs"
    },
    "./security": {
      "types": "./dist/sdk/security.d.ts",
      "import": "./dist/sdk/security.esm.js",
      "require": "./dist/sdk/security.cjs"
    },
    "./models": {
      "types": "./dist/sdk/models.d.ts",
      "import": "./dist/sdk/models.esm.js",
      "require": "./dist/sdk/models.cjs"
    },
    "./memory": {
      "types": "./dist/sdk/memory.d.ts",
      "import": "./dist/sdk/memory.esm.js",
      "require": "./dist/sdk/memory.cjs"
    },
    "./integrations": {
      "types": "./dist/sdk/integrations.d.ts",
      "import": "./dist/sdk/integrations.esm.js",
      "require": "./dist/sdk/integrations.cjs"
    },
    "./learning": {
      "types": "./dist/sdk/learning.d.ts",
      "import": "./dist/sdk/learning.esm.js",
      "require": "./dist/sdk/learning.cjs"
    },
    "./diagnostics": {
      "types": "./dist/sdk/diagnostics.d.ts",
      "import": "./dist/sdk/diagnostics.esm.js",
      "require": "./dist/sdk/diagnostics.cjs"
    },
    "./licensing/server": {
      "types": "./dist/licensing/index.d.ts",
      "import": "./dist/licensing/index.esm.js",
      "require": "./dist/licensing/index.cjs"
    },
    "./adapters/inspectra": {
      "types": "./dist/sdk/inspectra.d.ts",
      "import": "./dist/sdk/inspectra.esm.js",
      "require": "./dist/sdk/inspectra.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md",
    "adapters/inspectra/index.mjs",
    "adapters/inspectra/index.d.mts",
    "adapters/inspectra/README.md",
    "docs/sdk.md",
    "docs/release-readiness.md"
  ],
  "scripts": {
    "example:core": "pnpm build && node --experimental-strip-types examples/core.ts",
    "example:xor": "pnpm build && node examples/xor.mjs",
    "example:regression": "pnpm build && node examples/regression.mjs",
    "example:text": "pnpm build && node examples/text-classifier.mjs",
    "example:digits": "pnpm build && node --watch scripts/serve-examples.mjs",
    "build": "node scripts/clean.mjs && tsc && rollup -c rollup.config.mjs",
    "dev": "tsc --watch",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write src/**/*.ts",
    "audit": "pnpm audit --audit-level=low",
    "prepack": "pnpm lint && pnpm test",
    "verify:package": "node scripts/check-sdk-package.mjs"
  },
  "keywords": [
    "shivax",
    "ai",
    "ml",
    "javascript",
    "typescript",
    "nodejs",
    "browser",
    "artificial-intelligence",
    "machine-learning",
    "neural-network",
    "deep-learning",
    "tensor",
    "classification",
    "regression",
    "multi-agent",
    "ai-agents",
    "agent-framework",
    "agent-orchestration",
    "workflow-engine",
    "human-in-the-loop",
    "tool-calling",
    "capability-routing",
    "model-provider",
    "hybrid-ai",
    "local-ai",
    "ollama",
    "llm-integration",
    "scoped-memory",
    "semantic-search",
    "ui-inspection",
    "visual-comparison",
    "browser-automation-adapter",
    "authorization",
    "ai-evaluation",
    "feedback",
    "offline-training"
  ],
  "author": "Urvesh Gohil",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.6",
    "typescript": "^7.0.2"
  }
}
