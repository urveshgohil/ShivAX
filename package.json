{
  "name": "shivax",
  "version": "0.1.0",
  "description": "ShivAX — AI/ML library for JavaScript & TypeScript",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/index.cjs",
    "dist/index.esm.js",
    "dist/**/*.d.ts",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc && rollup -c rollup.config.mjs",
    "dev": "tsc --watch",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write src/**/*.ts",
    "audit": "pnpm audit --audit-level=low",
    "prepack": "pnpm lint && pnpm test"
  },
  "keywords": [
    "shivax",
    "ShivAX",
    "ai",
    "ml",
    "machine-learning"
  ],
  "author": "Urvesh Gohil",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.6",
    "typescript": "^7.0.2"
  }
}
